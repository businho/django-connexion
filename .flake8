[flake8]
max-line-length = 88
exclude =
    .git,
    __pycache__,
    .pytest_cache,
    .coverage,
    htmlcov,
    venv,
    build,
    dist,
    *.egg-info
ignore =
    # Line break before binary operator (conflicts with black)
    W503,
    # Line break after binary operator (conflicts with black)
    W504
per-file-ignores =
    # Ignore unused imports in __init__.py files
    __init__.py:F401
